# =========================================================================
# Variáveis de ambiente da Staypse
# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# Na Vercel: Project > Settings > Environment Variables.
# =========================================================================

# --- Supabase (projeto "staypse", região São Paulo) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA (começa com sb_publishable_). Pode ir para o navegador:
# quem protege os dados é a RLS do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave SECRETA (sb_secret_...). Só no servidor, nunca com NEXT_PUBLIC_.
# Usada para gravar inscrições da lista de espera (com limite por IP).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# OPCIONAL. Segredo para transformar o IP em hash (LGPD: o IP puro nunca é
# guardado). Se ficar de fora, o site deriva um a partir da SUPABASE_SECRET_KEY.
# Se quiser definir: openssl rand -hex 32 — e não troque depois de publicar.
# HASH_IP_SEGREDO=

# --- Site ---
# Endereço do site (links dos e-mails, link de indicação, prévias).
# Na Vercel, SEM domínio próprio: deixe em branco — o site usa sozinho o
# endereço que a Vercel dá (ex.: https://staypse.vercel.app).
# Quando comprar o domínio: https://staypse.com.br
# No computador: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lytex (Etapa 6 — ainda NÃO usar) ---
# Sempre sandbox até autorização expressa para produção.
# LYTEX_AMBIENTE=sandbox
